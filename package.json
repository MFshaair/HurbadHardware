    "next-intl": "^4",
    "next-themes": "^0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "vaul": "^1",
    "zod": "^4.6.7"
