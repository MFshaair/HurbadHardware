# Kenya region overrides (Vercel project: hurbadhardware-kenya).
# Primary write region. AWS RDS PostgreSQL primary + local read replica,
# both in eu-west-2 (London).

NEXT_PUBLIC_APP_URL="https://ke.hurbadhardware.com"
NEXT_PUBLIC_REGION="KE"
NEXT_PUBLIC_DEFAULT_CURRENCY="KES"
NEXT_PUBLIC_SUPPORTED_CURRENCIES="KES,USD"
TAX_RATE="0.16"
AWS_REGION="eu-west-2"

MPESA_ENV="production"
MPESA_CALLBACK_URL="https://ke.hurbadhardware.com/api/payments/mpesa/callback"
MPESA_BASE_URL="https://api.safaricom.co.ke"
# MPESA_CONSUMER_KEY / MPESA_CONSUMER_SECRET / MPESA_SHORTCODE / MPESA_PASSKEY
# are set as Vercel secrets on the hurbadhardware-kenya project — not stored here.

BETTER_AUTH_URL="https://ke.hurbadhardware.com"
