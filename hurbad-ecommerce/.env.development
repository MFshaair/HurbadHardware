# ---------------------------------------------------------------------------
# Local development configuration — Kenya region default.
# Safe to commit: contains only local Docker Postgres placeholders, no real
# secrets. Real per-developer secrets (Stripe/M-Pesa test keys, etc.) belong
# in `.env.development.local`, which is gitignored.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_REGION=KE
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Local Docker Postgres (see docs/DEPLOYMENT.md for docker-compose setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hurbad_ecommerce_dev?schema=public"

AUTH_URL=http://localhost:3000

MPESA_ENV=sandbox
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa

NEXT_PUBLIC_CURRENCY=KES
NEXT_PUBLIC_TAX_RATE=0.16

# Secrets below are intentionally left blank here — provide them via
# .env.development.local (gitignored):
#   STRIPE_PUBLIC_KEY=
#   STRIPE_SECRET_KEY=
#   STRIPE_WEBHOOK_SECRET=
#   MPESA_CONSUMER_KEY=
#   MPESA_CONSUMER_SECRET=
#   MPESA_SHORTCODE=
#   MPESA_PASSKEY=
#   SENDGRID_API_KEY=
#   AUTH_SECRET=
