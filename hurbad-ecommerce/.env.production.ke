# ---------------------------------------------------------------------------
# Production template — Kenya (primary region)
# Vercel region: eu-west-1 (London) — nearest edge to Kenya at time of launch.
# Database: AWS RDS PostgreSQL eu-west-1 (primary).
# Payment methods: M-Pesa (Daraja) + Stripe (Visa/Mastercard).
# Tax: 16% VAT.
#
# TEMPLATE ONLY — placeholder values. Ops fills in real secrets via
# Vercel Environment Variables (per-project, per-region), never by editing
# this file directly.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_REGION=KE
NEXT_PUBLIC_APP_URL=https://ke.hurbadhardware.com
NODE_ENV=production

DATABASE_URL=  # ops: AWS RDS eu-west-1 primary connection string (Vercel secret)

AUTH_URL=https://ke.hurbadhardware.com
AUTH_SECRET=  # ops: Vercel secret

STRIPE_PUBLIC_KEY=  # ops: Vercel secret (pk_live_...)
STRIPE_SECRET_KEY=  # ops: Vercel secret (sk_live_...)
STRIPE_WEBHOOK_SECRET=  # ops: Vercel secret

MPESA_CONSUMER_KEY=  # ops: Vercel secret (Safaricom Daraja production)
MPESA_CONSUMER_SECRET=  # ops: Vercel secret
MPESA_SHORTCODE=  # ops: Vercel secret
MPESA_PASSKEY=  # ops: Vercel secret
MPESA_CALLBACK_URL=https://ke.hurbadhardware.com/api/webhooks/mpesa
MPESA_ENV=production

SENDGRID_API_KEY=  # ops: Vercel secret
SENDGRID_FROM_EMAIL=orders@hurbadhardware.com

CLOUDFLARE_IMAGES_ACCOUNT_ID=  # ops: Vercel secret
CLOUDFLARE_IMAGES_API_TOKEN=  # ops: Vercel secret

NEXT_PUBLIC_CURRENCY=KES
NEXT_PUBLIC_TAX_RATE=0.16
