# ---------------------------------------------------------------------------
# Hurbad Electronics — Environment Variable Template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (or a region-specific `.env.<name>.local`)
# and fill in real values. Never commit files containing real secrets —
# only .env.example and the .env.development / .env.production.<region>
# TEMPLATES (placeholder values only) are tracked in git.
# ---------------------------------------------------------------------------

# --- Region -----------------------------------------------------------------
# One of: KE (Kenya), ET (Ethiopia), SO (Somalia)
NEXT_PUBLIC_REGION=KE

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (AWS RDS PostgreSQL) ------------------------------------------
# Primary: eu-west-1 (Kenya). Read replicas: af-south-1 (Ethiopia), eu-west-1 (Somalia).
# Local dev uses Docker Postgres — see docker-compose in docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hurbad_ecommerce?schema=public"
DATABASE_READ_REPLICA_URL="postgresql://USER:PASSWORD@HOST:5432/hurbad_ecommerce?schema=public"

# --- Auth (better-auth) ------------------------------------------------------
AUTH_SECRET=  # ops fills in — generate with `openssl rand -base64 32`
AUTH_URL=http://localhost:3000

# --- Stripe (Visa/Mastercard, all regions) -----------------------------------
STRIPE_PUBLIC_KEY=pk_test_...   # ops fills in
STRIPE_SECRET_KEY=sk_test_...   # ops fills in
STRIPE_WEBHOOK_SECRET=whsec_... # ops fills in

# --- M-Pesa Daraja (Kenya mobile money) --------------------------------------
MPESA_CONSUMER_KEY=...          # ops fills in — Safaricom Daraja sandbox/production
MPESA_CONSUMER_SECRET=...       # ops fills in
MPESA_SHORTCODE=...             # Paybill/Till number
MPESA_PASSKEY=...               # Lipa Na M-Pesa Online passkey
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa
MPESA_ENV=sandbox               # sandbox | production

# --- SendGrid (transactional email) ------------------------------------------
SENDGRID_API_KEY=...            # ops fills in
SENDGRID_FROM_EMAIL=orders@hurbadhardware.com

# --- Cloudflare (CDN / WAF / Images) ------------------------------------------
CLOUDFLARE_IMAGES_ACCOUNT_ID=...
CLOUDFLARE_IMAGES_API_TOKEN=...

# --- Regional tax / currency defaults (overridden per .env.production.*) ----
NEXT_PUBLIC_CURRENCY=KES
NEXT_PUBLIC_TAX_RATE=0.16
