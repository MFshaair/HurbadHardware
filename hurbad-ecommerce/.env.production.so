# ---------------------------------------------------------------------------
# Production template — Somalia (Phase 2 region)
# Vercel region: eu-west-1 (London) — same edge region as Kenya.
# Database: AWS RDS PostgreSQL read replica in eu-west-1 (primary stays
# in eu-west-1 / Kenya, per data-residency decision in the project plan).
# Payment methods: Stripe (Visa/Mastercard). EVC Plus planned Phase 2.
# Fallback: Stripe + cash-on-delivery if EVC Plus integration slips (see plan).
# Tax: variable (jurisdiction-dependent) — confirm with local compliance
# before launch; placeholder rate below.
#
# TEMPLATE ONLY — placeholder values. Ops fills in real secrets via
# Vercel Environment Variables, never by editing this file directly.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_REGION=SO
NEXT_PUBLIC_APP_URL=https://so.hurbadhardware.com
NODE_ENV=production

DATABASE_URL=  # ops: AWS RDS eu-west-1 primary connection string (Vercel secret)
DATABASE_READ_REPLICA_URL=  # ops: AWS RDS eu-west-1 read replica (Vercel secret)

AUTH_URL=https://so.hurbadhardware.com
AUTH_SECRET=  # ops: Vercel secret

STRIPE_PUBLIC_KEY=  # ops: Vercel secret (pk_live_...)
STRIPE_SECRET_KEY=  # ops: Vercel secret (sk_live_...)
STRIPE_WEBHOOK_SECRET=  # ops: Vercel secret

# EVC Plus — Phase 2, not yet integrated.
# EVCPLUS_MERCHANT_ID=
# EVCPLUS_API_KEY=

SENDGRID_API_KEY=  # ops: Vercel secret
SENDGRID_FROM_EMAIL=orders@hurbadhardware.com

CLOUDFLARE_IMAGES_ACCOUNT_ID=  # ops: Vercel secret
CLOUDFLARE_IMAGES_API_TOKEN=  # ops: Vercel secret

NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_TAX_RATE=0.00
