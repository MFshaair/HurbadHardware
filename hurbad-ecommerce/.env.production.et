# ---------------------------------------------------------------------------
# Production template — Ethiopia (Phase 2 region)
# Vercel region: af-south-1 (South Africa) — nearest edge to Ethiopia.
# Database: AWS RDS PostgreSQL read replica in af-south-1 (primary stays
# in eu-west-1 / Kenya, per data-residency decision in the project plan).
# Payment methods: Stripe (Visa/Mastercard). Telebirr planned Phase 2 (week 10).
# Tax: 15% VAT.
#
# TEMPLATE ONLY — placeholder values. Ops fills in real secrets via
# Vercel Environment Variables, never by editing this file directly.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_REGION=ET
NEXT_PUBLIC_APP_URL=https://et.hurbadhardware.com
NODE_ENV=production

DATABASE_URL=  # ops: AWS RDS eu-west-1 primary connection string (Vercel secret)
DATABASE_READ_REPLICA_URL=  # ops: AWS RDS af-south-1 read replica (Vercel secret)

AUTH_URL=https://et.hurbadhardware.com
AUTH_SECRET=  # ops: Vercel secret

STRIPE_PUBLIC_KEY=  # ops: Vercel secret (pk_live_...)
STRIPE_SECRET_KEY=  # ops: Vercel secret (sk_live_...)
STRIPE_WEBHOOK_SECRET=  # ops: Vercel secret

# Telebirr — Phase 2, not yet integrated (see plan: week 10 target).
# TELEBIRR_APP_ID=
# TELEBIRR_APP_KEY=
# TELEBIRR_SHORT_CODE=

SENDGRID_API_KEY=  # ops: Vercel secret
SENDGRID_FROM_EMAIL=orders@hurbadhardware.com

CLOUDFLARE_IMAGES_ACCOUNT_ID=  # ops: Vercel secret
CLOUDFLARE_IMAGES_API_TOKEN=  # ops: Vercel secret

NEXT_PUBLIC_CURRENCY=ETB
NEXT_PUBLIC_TAX_RATE=0.15
