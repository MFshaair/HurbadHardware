# Ethiopia region overrides (Vercel project: hurbadhardware-ethiopia).
# Reads from a local AWS RDS PostgreSQL read replica in af-south-1; writes
# go to the Kenya primary (eu-west-1) per the unified-write model.

NEXT_PUBLIC_APP_URL="https://et.hurbadhardware.com"
NEXT_PUBLIC_REGION="ET"
NEXT_PUBLIC_DEFAULT_CURRENCY="ETB"
NEXT_PUBLIC_SUPPORTED_CURRENCIES="ETB,USD"
TAX_RATE="0.15"
AWS_REGION="af-south-1"

# Telebirr is Phase 2 — left blank until that phase begins.
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""

NEXTAUTH_URL="https://et.hurbadhardware.com"
