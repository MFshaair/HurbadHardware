# Somalia region overrides (Vercel project: hurbadhardware-somalia).
# Reads from a local AWS RDS PostgreSQL read replica in eu-west-1 (same
# region as the primary); writes go to the Kenya primary per the unified
# write model.

NEXT_PUBLIC_APP_URL="https://so.hurbadhardware.com"
NEXT_PUBLIC_REGION="SO"
# Somalia uses SOS with USD as a common secondary settlement currency.
NEXT_PUBLIC_DEFAULT_CURRENCY="SOS"
NEXT_PUBLIC_SUPPORTED_CURRENCIES="SOS,USD"
# Somalia tax treatment is variable / not centrally standardized. Default to
# 0 until region-specific tax logic is implemented; do not assume a rate.
TAX_RATE="0"
AWS_REGION="eu-west-1"

# EVC Plus is Phase 2 — left blank until that phase begins.
EVCPLUS_MERCHANT_ID=""
EVCPLUS_API_KEY=""

NEXTAUTH_URL="https://so.hurbadhardware.com"
