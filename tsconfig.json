{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // hurbad-ecommerce/ is a separate, stale duplicate Next.js scaffold
  // (its own package.json, node_modules, next.config.ts against a
  // different Next.js version) — not part of this app. Without this
  // exclude, the root TS compiler type-checks its config file too and
  // `next build` fails on a NextConfig shape mismatch unrelated to this
  // project. See FEATURES.md M0-8 for the pending human decision on
  // whether to delete or repurpose that directory; this exclude only
  // unblocks the build, it doesn't resolve that decision.
  "exclude": ["node_modules", "hurbad-ecommerce"]
}
