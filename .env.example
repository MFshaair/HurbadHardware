# ==============================================================================
# HurbadHardware E-commerce Platform — Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development overrides, or use the
# region-specific files (.env.development, .env.production.kenya,
# .env.production.ethiopia, .env.production.somalia) as a base.
#
# Values here are placeholders only. Real secrets (Stripe live keys, M-Pesa
# production credentials, database passwords) must NEVER be committed to git.
# In Vercel, real secrets are managed via `vercel env add` / the Vercel
# dashboard's Environment Variables UI, scoped per-project (per-region).
# ==============================================================================

# ------------------------------------------------------------------------------
# App / Region
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# One of: KE (Kenya), ET (Ethiopia), SO (Somalia)
NEXT_PUBLIC_REGION="KE"
NEXT_PUBLIC_DEFAULT_CURRENCY="KES"
# Comma-separated ISO currency codes accepted in this region
NEXT_PUBLIC_SUPPORTED_CURRENCIES="KES"
# Tax rate applied at checkout for this region, as a decimal (e.g. 0.16 = 16%)
TAX_RATE="0.16"

# ------------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Primary (writer) — Kenya region, AWS RDS eu-west-2 (London) in production.
# Locally this points at a local Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hurbadhardware?schema=public"
# Optional read-replica URL for the current region. Falls back to DATABASE_URL
# when unset (e.g. in local development).
DATABASE_REPLICA_URL=""

# ------------------------------------------------------------------------------
# Stripe (all regions)
# ------------------------------------------------------------------------------
# Sandbox/test-mode keys. Obtain from https://dashboard.stripe.com/test/apikeys
# after creating a Stripe account — this is a manual, human-performed step
# (account creation cannot be automated by the deployment agent).
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ------------------------------------------------------------------------------
# M-Pesa Daraja API (Kenya)
# ------------------------------------------------------------------------------
# Sandbox credentials. Obtain from https://developer.safaricom.co.ke after
# registering an app in the Daraja sandbox — a manual, human-performed step.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="REPLACE_ME"
MPESA_CONSUMER_SECRET="REPLACE_ME"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="REPLACE_ME"
# Must be an absolute HTTPS URL reachable from the public internet — Daraja
# rejects http:// and localhost. For local dev, use a tunnel (ngrok/cloudflared).
# Path is canonical (ADR M4-2 Decision 7): it matches src/app/api/webhooks/stripe/,
# the PRD's file list, and vercel.json's `app/api/webhooks/**` maxDuration rule.
MPESA_CALLBACK_URL="https://REPLACE_ME.ngrok.app/api/webhooks/mpesa"
# ADR M4-2b Decision 1: Daraja does not sign callbacks — this opaque secret
# is composed as a path segment onto MPESA_CALLBACK_URL server-side
# (mpesaService.ts's buildCallbackUrl) and verified in constant time by
# src/app/api/webhooks/mpesa/[token]/route.ts. Generate with
# `openssl rand -hex 32` (64 hex chars, >= 32 required). Set as a Vercel
# ENCRYPTED env var in production — never commit a real value here.
MPESA_CALLBACK_SECRET="REPLACE_ME"
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
# Conservative per-transaction ceiling (ADR M4-2 Decision 5) — Safaricom's
# real production ceiling is tariff/shortcode-dependent; Daraja's own
# rejection is authoritative. This is a guard, not an asserted production
# figure.
MPESA_MAX_AMOUNT_KES="150000"

# ------------------------------------------------------------------------------
# SendGrid (order confirmation email, M5-1a / HRH-52)
# ------------------------------------------------------------------------------
# Sandbox/placeholder key. Obtain a real "Mail Send"-scoped API key from
# https://app.sendgrid.com after creating an account — a manual,
# human-performed step. Until replaced, getEmailService() falls back to
# ConsoleEmailService outside production, and refuses to send (fail-loud,
# ORDER_CONFIRMATION_EMAIL_FAILED reason: "not_configured") in production.
SENDGRID_API_KEY="SG.REPLACE_ME"
SENDGRID_FROM_EMAIL="orders@hurbadhardware.com"

# ------------------------------------------------------------------------------
# Telebirr (Ethiopia — Phase 2, placeholder only)
# ------------------------------------------------------------------------------
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""

# ------------------------------------------------------------------------------
# EVC Plus (Somalia — Phase 2, placeholder only)
# ------------------------------------------------------------------------------
EVCPLUS_MERCHANT_ID=""
EVCPLUS_API_KEY=""

# ------------------------------------------------------------------------------
# Secrets management
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="REPLACE_ME_WITH_RANDOM_32_BYTE_STRING"
BETTER_AUTH_URL="http://localhost:3000"
# Authenticates Vercel Cron invocations of
# /api/cron/release-expired-reservations (M3-2). Vercel auto-sends
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations when this
# is set on the project — the route fails closed (401) if it's unset.
CRON_SECRET="REPLACE_ME_WITH_RANDOM_32_BYTE_STRING"
