# ==============================================================================
# HurbadHardware E-commerce Platform — Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development overrides, or use the
# region-specific files (.env.development, .env.production.kenya,
# .env.production.ethiopia, .env.production.somalia) as a base.
#
# Values here are placeholders only. Real secrets (Stripe live keys, M-Pesa
# production credentials, database passwords) must NEVER be committed to git.
# In Vercel, real secrets are managed via `vercel env add` / the Vercel
# dashboard's Environment Variables UI, scoped per-project (per-region).
# ==============================================================================

# ------------------------------------------------------------------------------
# App / Region
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# One of: KE (Kenya), ET (Ethiopia), SO (Somalia)
NEXT_PUBLIC_REGION="KE"
NEXT_PUBLIC_DEFAULT_CURRENCY="KES"
# Comma-separated ISO currency codes accepted in this region
NEXT_PUBLIC_SUPPORTED_CURRENCIES="KES"
# Tax rate applied at checkout for this region, as a decimal (e.g. 0.16 = 16%)
TAX_RATE="0.16"

# ------------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Primary (writer) — Kenya region, AWS RDS eu-west-2 (London) in production.
# Locally this points at a local Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hurbadhardware?schema=public"
# Optional read-replica URL for the current region. Falls back to DATABASE_URL
# when unset (e.g. in local development).
DATABASE_REPLICA_URL=""

# ------------------------------------------------------------------------------
# Stripe (all regions)
# ------------------------------------------------------------------------------
# Sandbox/test-mode keys. Obtain from https://dashboard.stripe.com/test/apikeys
# after creating a Stripe account — this is a manual, human-performed step
# (account creation cannot be automated by the deployment agent).
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ------------------------------------------------------------------------------
# M-Pesa Daraja API (Kenya)
# ------------------------------------------------------------------------------
# Sandbox credentials. Obtain from https://developer.safaricom.co.ke after
# registering an app in the Daraja sandbox — a manual, human-performed step.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="REPLACE_ME"
MPESA_CONSUMER_SECRET="REPLACE_ME"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="REPLACE_ME"
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"

# ------------------------------------------------------------------------------
# Telebirr (Ethiopia — Phase 2, placeholder only)
# ------------------------------------------------------------------------------
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""

# ------------------------------------------------------------------------------
# EVC Plus (Somalia — Phase 2, placeholder only)
# ------------------------------------------------------------------------------
EVCPLUS_MERCHANT_ID=""
EVCPLUS_API_KEY=""

# ------------------------------------------------------------------------------
# Secrets management
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="REPLACE_ME_WITH_RANDOM_32_BYTE_STRING"
NEXTAUTH_URL="http://localhost:3000"
