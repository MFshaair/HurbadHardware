# Local development defaults (Kenya region, sandbox everything).
# Safe to commit: no real secrets, only sandbox/test placeholders and
# localhost values. Override anything sensitive in a git-ignored
# .env.development.local file.

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REGION="KE"
NEXT_PUBLIC_DEFAULT_CURRENCY="KES"
NEXT_PUBLIC_SUPPORTED_CURRENCIES="KES,USD"
TAX_RATE="0.16"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hurbadhardware_dev?schema=public"
DATABASE_REPLICA_URL=""

STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="REPLACE_ME"
MPESA_CONSUMER_SECRET="REPLACE_ME"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="REPLACE_ME"
# ADR M4-2 Decision 7: must be https:// (Daraja rejects http/localhost) —
# this placeholder satisfies mpesaService.ts's fail-closed check for local
# dev/tests; real delivery requires a tunnel (ngrok/cloudflared).
MPESA_CALLBACK_URL="https://REPLACE_ME.ngrok.app/api/webhooks/mpesa"
# ADR M4-2b Decision 1: a real value here IS the entire trust boundary on a
# publicly reachable endpoint the moment a developer runs the documented
# ngrok/cloudflared tunnel workflow above, so — unlike the stated rationale
# in an earlier draft of this file — it is NOT safe to commit a working
# value, and per security-signoff M4-2b F2 it follows the same convention as
# every other M-Pesa credential in this block: REPLACE_ME here, a real
# generated value (`openssl rand -hex 32`) only in your own untracked
# .env.local. Tests set process.env.MPESA_CALLBACK_SECRET directly, so this
# placeholder does not block the suite from running.
MPESA_CALLBACK_SECRET="REPLACE_ME"
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
MPESA_MAX_AMOUNT_KES="150000"

# M5-1a / HRH-52: dev-only placeholder. Left as REPLACE_ME so
# getEmailService() falls back to ConsoleEmailService (logs the rendered
# email to stdout) — dogfoodable locally without a real SendGrid account.
SENDGRID_API_KEY="SG.REPLACE_ME"
SENDGRID_FROM_EMAIL="orders@hurbadhardware.com"

TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""
EVCPLUS_MERCHANT_ID=""
EVCPLUS_API_KEY=""

BETTER_AUTH_SECRET="dev-only-insecure-secret-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# M3-2: authenticates Vercel Cron invocations of
# /api/cron/release-expired-reservations. Dev-only placeholder, not a real
# secret.
CRON_SECRET="dev-only-insecure-cron-secret-do-not-use-in-production"
